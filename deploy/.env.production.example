# Copy this file to /opt/relayforge/.env.production on EC2. Do not commit the copy.
# Every replace-with value must be independently generated; this file contains no usable secret.

RELAYFORGE_BACKEND_IMAGE=gialong1416/relayforge-backend
RELAYFORGE_GATEWAY_IMAGE=gialong1416/relayforge-gateway
RELAYFORGE_IMAGE_TAG=replace-with-immutable-git-sha-tag

RELAYFORGE_DOMAIN=relayforge.example.com
RELAYFORGE_PUBLIC_ORIGIN=https://relayforge.example.com
RELAYFORGE_CADDY_EMAIL=you@example.com

RELAYFORGE_DB_NAME=relayforge
RELAYFORGE_DB_USERNAME=relayforge
RELAYFORGE_DB_PASSWORD=replace-with-production-database-password

RELAYFORGE_API_KEY_PEPPER=replace-with-random-production-pepper
# Base64URL encoding of exactly 32 random bytes.
RELAYFORGE_ENDPOINT_ENCRYPTION_KEY=replace-with-base64url-32-byte-key
RELAYFORGE_ENDPOINT_ENCRYPTION_KEY_REFERENCE=ec2-compose-aes-gcm-v1

# Set to true only for the controlled initial owner seed, then set it back to false.
RELAYFORGE_BOOTSTRAP_OWNER_ENABLED=false
RELAYFORGE_BOOTSTRAP_OWNER_LOGIN_NAME=owner
RELAYFORGE_BOOTSTRAP_OWNER_PASSWORD=123456
