# Copy this file to .env before running Docker Compose.
# These are local-development values only. Use independently generated values and never commit .env.
RELAYFORGE_DB_NAME=relayforge
RELAYFORGE_DB_USERNAME=relayforge
RELAYFORGE_DB_PASSWORD=replace-with-local-database-password

RELAYFORGE_API_KEY_PEPPER=replace-with-random-local-pepper
# Base64URL encoding of exactly 32 random bytes.
RELAYFORGE_ENDPOINT_ENCRYPTION_KEY=replace-with-base64url-32-byte-key
RELAYFORGE_ENDPOINT_ENCRYPTION_KEY_REFERENCE=local-aes-gcm-v1

RELAYFORGE_OWNER_LOGIN_NAME=owner
RELAYFORGE_OWNER_PASSWORD=replace-with-local-owner-password

