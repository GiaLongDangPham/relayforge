# Copy to .env for local development. Do not commit .env or reuse these placeholders in production.
RELAYFORGE_RUNTIME=api

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/relayforge
SPRING_DATASOURCE_USERNAME=relayforge
SPRING_DATASOURCE_PASSWORD=replace-with-local-password

RELAYFORGE_API_KEY_PEPPER=replace-with-random-local-pepper
# Base64URL encoding of exactly 32 random bytes.
RELAYFORGE_ENDPOINT_ENCRYPTION_KEY=replace-with-base64url-32-byte-key
RELAYFORGE_ENDPOINT_ENCRYPTION_KEY_REFERENCE=local-aes-gcm-v1

RELAYFORGE_DASHBOARD_ORIGIN=http://localhost:5173
RELAYFORGE_SECURE_COOKIES=false
RELAYFORGE_PRODUCTION=false
RELAYFORGE_ENDPOINT_ALLOW_LOCAL_HTTP=true

RELAYFORGE_BOOTSTRAP_OWNER_ENABLED=true
RELAYFORGE_BOOTSTRAP_OWNER_LOGIN_NAME=owner
RELAYFORGE_BOOTSTRAP_OWNER_PASSWORD=replace-with-local-owner-password
